# Copy to .env and adjust. Loaded by start.ps1 / start-all.ps1
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8177
# Leave empty to disable auth. If set, all clients must send this token in `hello`.
BRIDGE_TOKEN=
# Hermes binary (override if not at the default location)
HERMES_BIN=C:\Users\user\AppData\Local\hermes\bin\hermes.exe
