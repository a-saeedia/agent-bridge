# Copy to .env and adjust. Loaded by start.ps1 / start-all.ps1.
# Never commit the real .env.

BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8177
# Leave empty to disable auth. If set, all clients must send this token in hello.
BRIDGE_TOKEN=

# Hermes binary path (override if not discoverable on PATH)
# HERMES_BIN=<full path to hermes.exe>
